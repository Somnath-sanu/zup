
# For local development with docker-compose, use: postgresql://zupuser:zuppass123@postgres:5432/zup
# For production, use your cloud database URL
DATABASE_URL=postgresql://zupuser:zuppass123@localhost:5432/zup

# Get these from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Get your API key from: https://e2b.dev/docs
E2B_API_KEY=your_e2b_api_key_here

# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Get these from: https://www.inngest.com/docs
# Run inngest via inngest-cli


# Get your API key from: https://www.firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here


# Optional - only if using Polar for payments
# POLAR_ACCESS_TOKEN=your_polar_access_token_here
# POLAR_ORGANIZATION_ID=your_polar_org_id_here


NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
